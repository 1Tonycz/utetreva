    <h2>{_'ui.reservation.room.title'}</h2>
    <p>{_'ui.reservation.room.subtitle'}</p>
    {if flashes}
            {foreach $flashes as $flash}
                <p class="form__{$flash->type}">{$flash->message}</p>
            {/foreach}
    {/if}
    {form reservationForm}
        <div class="form__row">
            <div class="form__input">
                {label First/}
                {input First}
            </div>
            <div class="form__input">
                {label Second/}
                {input Second}
            </div>
        </div>
        <div class="form__row">
            <div class="form__input">
                {label Mail/}
                {input Mail}
            </div>
            <div class="form__input">
                {label Tel/}
                {input Tel}
            </div>
        </div>
        <div class="form__row">
            <div class="form__input">
                {label Date_from/}
                {input Date_from}
            </div>
            <div class="form__input">
                {label Date_to/}
                {input Date_to}
            </div>
        </div>
        <div class="form__row">
            <div class="form__input">
                {label Person/}
                {input Person}
            </div>
            <div class="form__input">
                {label Child/}
                {input Child}
            </div>
            <div class="form__input">
                {label Baby/}
                {input Baby}
            </div>

        </div>
        <div class=" form__row">
            <div class="form__input" id="checkbox">
                {label Dog/}
                {input Dog}
            </div>
            <div class="form__input">
                {label Dog_count/}
                {input Dog_count}
            </div>
        </div>
        <div class="form__row">
            <div class="form__input">
                {label Note/}
                {input Note}
            </div>
        </div>
        <div class="form__row">
            {input Gdpr}
            {input Newsletter}
        </div>
        {input Submit}
    {/form}
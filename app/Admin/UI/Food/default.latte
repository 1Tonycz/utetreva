{var $css = "food"}

{block content}

<div n:snippet="tabs" class="tabs tabs--wrap">
    {foreach $cats as $id => $label}
        <a n:href="this, cat => $id"
                data-naja
                class="tab {if $cat === $id}is-active{/if}">
            {$label}
        </a>
    {/foreach}
    <a n:href=":Admin:Food:create" class="btn btn--primary">
        + Přidat jídlo
    </a>
</div>

<div n:snippet="foods">
    <h3>{$cats[$cat]}</h3>

    {if $foods}
        {foreach $foods as $food}
            <div class="food-item">
                <div>
                    <h4>{$food->Name_cs}</h4>
                    <div class="price">{$food->Price} Kč</div>
                </div>
                <div class="actions">
                    <button type="button"
                            class="icon-btn icon-btn--edit"
                            title="Upravit"
                            data-modal-open="food-edit"
                            data-food-id="{$food->ID}"
                            data-food-price="{$food->Price}"
                            data-food-cat="{$food->Category}"
                            data-food-archived="{$food->Archived}"

                            {** názvy **}
                            data-food-name-cs="{$food->Name_cs ?? ''}"
                            data-food-name-de="{$food->Name_de ?? ''}"
                            data-food-name-en="{$food->Name_en ?? ''}"
                            data-food-name-ru="{$food->Name_ru ?? ''}"

                            {** popisy **}
                            data-food-description-cs="{$food->Description_cs ?? ''}"
                            data-food-description-de="{$food->Description_de ?? ''}"
                            data-food-description-en="{$food->Description_en ?? ''}"
                            data-food-description-ru="{$food->Description_ru ?? ''}">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-pencil-square" viewBox="0 0 16 16">
                            <path d="M15.502 1.94a.5.5 0 0 1 0 .706L14.459 3.69l-2-2L13.502.646a.5.5 0 0 1 .707 0l1.293 1.293zm-1.75 2.456-2-2L4.939 9.21a.5.5 0 0 0-.121.196l-.805 2.414a.25.25 0 0 0 .316.316l2.414-.805a.5.5 0 0 0 .196-.12l6.813-6.814z"/>
                            <path fill-rule="evenodd" d="M1 13.5A1.5 1.5 0 0 0 2.5 15h11a1.5 1.5 0 0 0 1.5-1.5v-6a.5.5 0 0 0-1 0v6a.5.5 0 0 1-.5.5h-11a.5.5 0 0 1-.5-.5v-11a.5.5 0 0 1 .5-.5H9a.5.5 0 0 0 0-1H2.5A1.5 1.5 0 0 0 1 2.5z"/>
                        </svg>
                    </button>
                    <a n:href="archive!, id => $food->ID" data-naja class="icon-btn icon-btn--archive" title="Archivovat"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-archive" viewBox="0 0 16 16">
                            <path d="M0 2a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v2a1 1 0 0 1-1 1v7.5a2.5 2.5 0 0 1-2.5 2.5h-9A2.5 2.5 0 0 1 1 12.5V5a1 1 0 0 1-1-1zm2 3v7.5A1.5 1.5 0 0 0 3.5 14h9a1.5 1.5 0 0 0 1.5-1.5V5zm13-3H1v2h14zM5 7.5a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 0 1h-5a.5.5 0 0 1-.5-.5"/>
                        </svg></a>
                    <a n:href="delete!, id => $food->ID" data-naja class="icon-btn icon-btn--restore" title="Smazat"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-trash" viewBox="0 0 16 16">
                            <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z"/>
                            <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z"/>
                        </svg></a>
                </div>
            </div>
        {/foreach}
    {else}
        <p>V této kategorii zatím nic není.</p>
    {/if}

    <h3 style="margin-top:1rem;">Archivované položky</h3>
    {if $archived}
        {foreach $archived as $food}
            <div class="food-item is-archived">
                <div>
                    <strong>{$food->Name_cs}</strong>
                    <div class="price">{$food->Price} Kč</div>
                </div>
                <div class="actions">
                    <button type="button"
                            class="icon-btn icon-btn--edit"
                            title="Upravit"
                            data-modal-open="food-edit"
                            data-food-id="{$food->ID}"
                            data-food-price="{$food->Price}"
                            data-food-cat="{$food->Category}"
                            data-food-archived="{$food->Archived}"

                            {** názvy **}
                            data-food-name-cs="{$food->Name_cs ?? ''}"
                            data-food-name-de="{$food->Name_de ?? ''}"
                            data-food-name-en="{$food->Name_en ?? ''}"
                            data-food-name-ru="{$food->Name_ru ?? ''}"

                            {** popisy **}
                            data-food-description-cs="{$food->Description_cs ?? ''}"
                            data-food-description-de="{$food->Description_de ?? ''}"
                            data-food-description-en="{$food->Description_en ?? ''}"
                            data-food-description-ru="{$food->Description_ru ?? ''}">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-pencil-square" viewBox="0 0 16 16">
                            <path d="M15.502 1.94a.5.5 0 0 1 0 .706L14.459 3.69l-2-2L13.502.646a.5.5 0 0 1 .707 0l1.293 1.293zm-1.75 2.456-2-2L4.939 9.21a.5.5 0 0 0-.121.196l-.805 2.414a.25.25 0 0 0 .316.316l2.414-.805a.5.5 0 0 0 .196-.12l6.813-6.814z"/>
                            <path fill-rule="evenodd" d="M1 13.5A1.5 1.5 0 0 0 2.5 15h11a1.5 1.5 0 0 0 1.5-1.5v-6a.5.5 0 0 0-1 0v6a.5.5 0 0 1-.5.5h-11a.5.5 0 0 1-.5-.5v-11a.5.5 0 0 1 .5-.5H9a.5.5 0 0 0 0-1H2.5A1.5 1.5 0 0 0 1 2.5z"/>
                        </svg>
                    </button>
                    <a n:href="unarchive!, id => $food->ID" data-naja class="icon-btn icon-btn--restore" title="Obnovit"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-clockwise" viewBox="0 0 16 16">
                            <path fill-rule="evenodd" d="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2z"/>
                            <path d="M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466"/>
                        </svg></a>
                    <a n:href="delete!, id => $food->ID" data-naja class="icon-btn icon-btn--restore" title="Smazat"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-trash" viewBox="0 0 16 16">
                            <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z"/>
                            <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z"/>
                        </svg></a>
                </div>
            </div>
        {/foreach}
    {else}
        <p>Žádné archivované položky.</p>
    {/if}
</div>
<div id="modal-food-edit" class="modal" aria-hidden="true">
    <div class="modal-content" role="dialog" aria-modal="true" aria-labelledby="foodEditTitle">

        <!-- Header (sticky) -->
        <button type="button" class="modal-close" data-modal-close aria-label="Zavřít">×</button>
        <div class="modal__header">
            <h3 id="foodEditTitle">Upravit jídlo</h3>
        </div>

        <!-- Body (scrolluje se uvnitř) -->
        <div class="modal__body">
            <form id="foodEditForm" method="post" action="{link editFood!}" autocomplete="off">
                <input type="hidden" name="id" id="fe-id">

                <!-- Názvy ve všech jazycích -->
                <fieldset class="field-group">
                    <legend>Názvy</legend>

                    <div class="field">
                        <label for="fe-name-cs"><span>Název (česky) *</span></label>
                        <input type="text" name="name_cs" id="fe-name-cs" required>
                    </div>

                    <div class="field">
                        <label for="fe-name-de"><span>Název (německy)</span></label>
                        <input type="text" name="name_de" id="fe-name-de">
                    </div>

                    <div class="field">
                        <label for="fe-name-en"><span>Název (anglicky)</span></label>
                        <input type="text" name="name_en" id="fe-name-en">
                    </div>

                    <div class="field">
                        <label for="fe-name-ru"><span>Název (rusky)</span></label>
                        <input type="text" name="name_ru" id="fe-name-ru">
                    </div>

                    <p class="help">Vyplňte alespoň český název. Ostatní jazyky jsou volitelné.</p>
                </fieldset>

                <!-- Popisy ve všech jazycích -->
                <fieldset class="field-group">
                    <legend>Popisy</legend>

                    <div class="field">
                        <label for="fe-desc-cs"><span>Popis (česky)</span></label>
                        <textarea name="description_cs" id="fe-desc-cs" rows="3" placeholder="Krátký popis jídla..."></textarea>
                    </div>

                    <div class="field">
                        <label for="fe-desc-de"><span>Popis (německy)</span></label>
                        <textarea name="description_de" id="fe-desc-de" rows="3" placeholder="Kurze Beschreibung des Gerichts..."></textarea>
                    </div>

                    <div class="field">
                        <label for="fe-desc-en"><span>Popis (anglicky)</span></label>
                        <textarea name="description_en" id="fe-desc-en" rows="3" placeholder="Short dish description..."></textarea>
                    </div>

                    <div class="field">
                        <label for="fe-desc-ru"><span>Popis (rusky)</span></label>
                        <textarea name="description_ru" id="fe-desc-ru" rows="3" placeholder="Краткое описание блюда..."></textarea>
                    </div>
                </fieldset>

                <!-- Cena -->
                <div class="field">
                    <label for="fe-price"><span>Cena (Kč)</span></label>
                    <input type="number" name="price" id="fe-price" min="0" step="1" inputmode="numeric" required>
                </div>

                <!-- Kategorie -->
                <div class="field">
                    <label for="fe-cat"><span>Kategorie</span></label>
                    <select name="category" id="fe-cat" required>
                        {foreach $cats as $catId => $catLabel}
                            <option value="{$catId}">{$catLabel}</option>
                        {/foreach}
                    </select>
                </div>

                <!-- Archivace -->
                <div class="field" style="display:flex; align-items:center; gap:8px;">
                    <label for="fe-archived" style="display:flex; align-items:center; gap:8px;">
                        <input type="checkbox" name="archived" id="fe-archived" value="1">
                        <span>Archivovat</span>
                    </label>
                </div>
            </form>
        </div>

        <!-- Footer (sticky) -->
        <div class="modal__footer">
            <div class="modal-actions">
                <button type="button" class="btn" data-modal-close>Zrušit</button>
                <button type="submit" class="btn primary" form="foodEditForm">Uložit změny</button>
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        const MODAL_ID_EDIT = 'modal-food-edit';

        function $(root, sel) { return (root || document).querySelector(sel); }
        function setVal(root, sel, value) {
            const el = $(root, sel);
            if (!el) return;
            if (el.type === 'checkbox') {
                el.checked = value === true || value === '1';
            } else if (el.tagName === 'SELECT') {
                el.value = String(value ?? '');
            } else {
                el.value = String(value ?? '');
            }
        }
        function openModalById(id) {
            const el = document.getElementById(id);
            if (!el) return;
            el.setAttribute('aria-hidden', 'false');
            // po otevření se pokus o focus do prvního pole
            setTimeout(() => el.querySelector('input, select, textarea')?.focus(), 0);
        }
        function closeModal(el) { el.setAttribute('aria-hidden', 'true'); }

        function resetFoodEditForm(el) {
            // vyčistí všechna známá pole v modalu (bez ohledu na create/edit)
            setVal(el, '#fe-id', '');
            setVal(el, '#fe-name-cs', '');
            setVal(el, '#fe-name-de', '');
            setVal(el, '#fe-name-en', '');
            setVal(el, '#fe-name-ru', '');
            setVal(el, '#fe-desc-cs', '');
            setVal(el, '#fe-desc-de', '');
            setVal(el, '#fe-desc-en', '');
            setVal(el, '#fe-desc-ru', '');
            setVal(el, '#fe-price', '');
            setVal(el, '#fe-cat', '');
            setVal(el, '#fe-archived', false);
        }

        function fillFoodEditFromDataset(opener) {
            const el = document.getElementById(MODAL_ID_EDIT);
            if (!el) return;

            // reset pro jistotu (pokud modal používáš i pro "vytvořit", zůstane čistý)
            resetFoodEditForm(el);

            // načtení dat z openeru
            const d = opener.dataset;

            // povinná/klíčová pole
            setVal(el, '#fe-id', d.foodId || '');

            // názvy
            setVal(el, '#fe-name-cs', d.foodNameCs || '');
            setVal(el, '#fe-name-de', d.foodNameDe || '');
            setVal(el, '#fe-name-en', d.foodNameEn || '');
            setVal(el, '#fe-name-ru', d.foodNameRu || '');

            // popisy
            setVal(el, '#fe-desc-cs', d.foodDescriptionCs || '');
            setVal(el, '#fe-desc-de', d.foodDescriptionDe || '');
            setVal(el, '#fe-desc-en', d.foodDescriptionEn || '');
            setVal(el, '#fe-desc-ru', d.foodDescriptionRu || '');

            // čísla a ostatní
            setVal(el, '#fe-price', d.foodPrice || '');
            setVal(el, '#fe-cat', d.foodCat || '');
            setVal(el, '#fe-archived', (d.foodArchived === '1'));

            // otevřít modal
            openModalById(MODAL_ID_EDIT);
        }

        document.addEventListener('click', function (e) {
            const opener = e.target.closest('[data-modal-open]');
            if (opener) {
                e.preventDefault();
                const target = opener.getAttribute('data-modal-open');

                // Speciální obsluha pro food-edit: naplnění polí
                if (target === 'food-edit') {
                    fillFoodEditFromDataset(opener);
                    return;
                }

                // Ostatní modaly (pokud máš)
                openModalById('modal-' + target);
                return;
            }

            const closer = e.target.closest('[data-modal-close]');
            if (closer) {
                e.preventDefault();
                const m = closer.closest('.modal');
                if (m) closeModal(m);
                return;
            }

            // klik mimo obsah zavírá
            const modal = e.target.closest('.modal');
            if (modal && e.target === modal) closeModal(modal);
        });

        // Esc zavírá aktivní modaly
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') {
                document.querySelectorAll('.modal[aria-hidden="false"]').forEach(closeModal);
            }
        });

        // Po AJAXu (Naja) – není třeba nic znovu navěšovat, delegace zůstává
        document.addEventListener('naja:complete', () => {
            // záměrně prázdné
        });

        // Volitelné: pokud chceš přenastavit step/min pro cenu dynamicky
        const price = document.getElementById('fe-price');
        if (price) {
            // můžeš povolit i desetinné částky: price.step = '0.01';
            // price.min = '0';
        }
    })();
</script>


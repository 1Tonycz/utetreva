{var $css = "detail"}

{block content}

    <div class="detail-container">
        <div class="card">
            <div class="card-header">Informace o voucheru</div>
            <div class="info-list">
                <div class="info-row">
                    <div class="info-label">Jméno</div>
                    <div class="info-value">
                        {if $detail->First !== null && $detail->First !== ''}
                            <p>Jméno: {$detail->First} {$detail->Second}</p>
                        {else}
                            <p>Jméno neznámé - zakoupeno na restauraci</p>
                        {/if}
                    </div>
                </div>
                <div class="info-row">
                    <div class="info-label">Číslo voucheru:</div>
                    <div class="info-value">{ifset $detail->Code}{$detail->Code}{/ifset}</div>
                </div>
                <div class="info-row">
                    <div class="info-label">Zakoupen:</div>
                    <div class="info-value">{$detail->Date|date: 'd.m.Y'}</div>
                </div>
                <div class="info-row">
                    <div class="info-label">Častka</div>
                    <div class="info-value">{$detail->Amount}</div>
                </div>
                <div class="info-row">
                    <div class="info-label">Poznámka</div>
                    <div class="info-value">{$detail->Note}</div>
                </div>
            </div>
        </div>

        <!-- Pravý sloupec – pokoje a akce -->
        <div class="card">
            <div class="actions" style="margin-top:16px;">
                {if $user->isAllowed('voucher','comments')}<button type="button" class="btn secondary" data-modal-open="comment" data-res-id="{$detail->ID}">💬 Upravit poznámku</button>{/if}
                {if $user->isAllowed('voucher','setAmount')}<button type="button" class="btn secondary voucher__set" data-modal-open="set-amount" data-action="{link setAmount2! id => $detail->ID}" data-current="{$detail->Amount}" data-id="{$detail->ID}">💰 Nastavit částku</button>{/if}
                {if $user->isAllowed('voucher','delete')}<a href="{link deleteVoucher! id => $detail->ID}" class="btn danger" onclick="return confirm('Opravdu smazat tento voucher?');">🗑️ Smazat voucher</a>{/if}
            </div>
        </div>
    </div>


    <div class="card comment-section">
        <div class="card-header">Aktivita změn částek</div>
            {foreach $history as $h}
                <div class="comment-item">
                    <div class="comment-meta">{$h->changed_at|date:'d.m.Y H:i'}</div>
                    <div class="comment-body">Změněna z <strong>{$h->old_amount}</strong> na <strong>{$h->new_amount}</strong></div>
                </div>
            {/foreach}
    </div>
    <!-- MODALY -->

    {* MODAL: Upravit poznámku *}
    <div id="modal-comment" class="modal" aria-hidden="true">
        <div class="modal-content" role="dialog" aria-modal="true" aria-labelledby="commentTitle">
            <button type="button" class="modal-close" data-modal-close aria-label="Zavřít">×</button>
            <h3 id="commentTitle">Upravit poznámku</h3>

            <form method="post" action="{link saveComment!}">
                <input type="hidden" name="voucher_id" value="{$detail->ID}">
                <div class="field" style="margin-top:.5rem;">
                    <label for="comment-text" style="display:block; font-weight:600; margin-bottom:6px;">Poznámka</label>
                    <textarea id="comment-text" name="note" rows="6" required>{$detail->Note}</textarea>
                </div>

                <div class="modal-actions" style="margin-top:.75rem;">
                    <button type="button" class="btn" data-modal-close>Zavřít</button>
                    <button type="submit" class="btn primary">Uložit</button>
                </div>
            </form>
        </div>
    </div>

    {* MODAL: Nastavit částku *}
    <div id="modal-set-amount" class="modal" aria-hidden="true">
        <div class="modal-content" role="dialog" aria-modal="true" aria-labelledby="setAmountTitle">
            <button type="button" class="modal-close" data-modal-close aria-label="Zavřít">×</button>
            <h3 id="setAmountTitle">Nastavit částku</h3>

            <form id="form-set-amount" method="post" action="">
                <input type="hidden" name="id" value="{$detail->ID}">
                <div class="field" style="margin-top:.5rem;">
                    <label for="amount" style="display:block; font-weight:600; margin-bottom:6px;">Nová částka</label>
                    <input id="amount" name="amount" type="number" step="1" min="0" required>
                </div>

                <div class="modal-actions" style="margin-top:.75rem;">
                    <button type="button" class="btn" data-modal-close>Zavřít</button>
                    <button type="submit" class="btn primary">Uložit</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        (function () {
            // ---------- Helpers ----------
            function openModal(name) {
                const el = document.getElementById('modal-' + name);
                if (!el) return;
                el.setAttribute('aria-hidden', 'false');

                // Fokus na první ovladatelný prvek
                setTimeout(() => {
                    const focusable = el.querySelector('input, textarea, select, button, [tabindex]:not([tabindex="-1"])');
                    if (focusable) focusable.focus();
                }, 0);
            }

            function closeModal(modalEl) {
                if (!modalEl) return;
                modalEl.setAttribute('aria-hidden', 'true');
            }

            // ---------- Delegace kliků: otevření/zavření modalu ----------
            document.addEventListener('click', function (e) {
                // Otevření modalu
                const opener = e.target.closest('[data-modal-open]');
                if (opener) {
                    e.preventDefault();
                    const name = opener.getAttribute('data-modal-open');
                    if (!name) return;

                    // Speciální příprava pro modal "set-amount"
                    if (name === 'set-amount') {
                        const form  = document.getElementById('form-set-amount');
                        const input = document.getElementById('amount');
                        if (form) {
                            const action = opener.getAttribute('data-action') || '';
                            const id     = opener.getAttribute('data-id') || '';
                            form.action  = action;
                            const idInput = form.querySelector('input[name="id"]');
                            if (idInput) idInput.value = id;
                        }
                        if (input) {
                            const current = opener.getAttribute('data-current') || '';
                            input.value = current;
                        }
                    }

                    openModal(name);
                    return;
                }

                // Zavření modalu přes [data-modal-close]
                const closer = e.target.closest('[data-modal-close]');
                if (closer) {
                    e.preventDefault();
                    const modal = closer.closest('.modal');
                    if (modal) closeModal(modal);
                    return;
                }
            });

            // ---------- Zavření klikem mimo obsah (na backdrop) ----------
            document.addEventListener('click', function (e) {
                const modal = e.target.closest('.modal');
                if (modal && e.target === modal) {
                    closeModal(modal);
                }
            });

            // ---------- Zavření klávesou Escape ----------
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') {
                    document.querySelectorAll('.modal[aria-hidden="false"]').forEach(function (m) {
                        m.setAttribute('aria-hidden', 'true');
                    });
                }
            });
        })();
    </script>


{/block}
